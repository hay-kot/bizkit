      "description": "Set a project secret that async scripts read as ctx.secrets",
      "inputSchema": {
        "$defs": {
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "A secret's new value.",
        "properties": {
          "name": {
            "description": "The name: an uppercase letter, then up to 63 uppercase letters, digits or `_`.",
            "type": "string"
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project."
          },
          "value": {
            "description": "The value, at most 4 KiB. Never returned.",
            "type": "string"
          }
        },
        "required": [
          "project_id",
          "name",
          "value"
        ],
        "type": "object"
      },
