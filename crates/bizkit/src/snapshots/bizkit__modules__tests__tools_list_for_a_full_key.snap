      },
      "description": "List scripts, by name",
      "inputSchema": {
        "$defs": {
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Which scripts to list.",
        "properties": {
          "project_id": {
            "oneOf": [
              {
                "$ref": "#/$defs/ProjectId",
                "description": "Only this project's scripts."
              },
              {
                "type": "null"
              }
            ]
          },
          "target_id": {
            "description": "Only scripts that run for this entity, as `targets[].id` spells it:\nthose that name it, and those on points of its kind that target\nevery entity.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "name": "extensions_scripts_list"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Run a script's test cases, saved or given, one after another with its hook point's capabilities, real fetch included, and record each run",
      "inputSchema": {
        "$defs": {
          "ScriptId": {
            "format": "uuid",
            "type": "string"
          },
          "TestCase": {
            "additionalProperties": false,
            "description": "A saved input to run a script on, and what it must return.",
            "properties": {
              "expect": {
                "type": [
                  "object",
                  "array",
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "input": {
                "type": [
                  "object",
                  "array",
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "name": {
                "description": "A name, unique in the script.",
                "type": "string"
              }
            },
            "required": [
              "name",
              "input"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "A test run.",
        "properties": {
          "script_id": {
            "$ref": "#/$defs/ScriptId",
            "description": "The script."
          },
          "source": {
            "description": "Runs this source instead of the saved one, at most 64 KiB.",
            "type": [
              "string",
              "null"
            ]
          },
          "tests": {
            "description": "Runs these cases instead of the saved ones, at most 20; pass one\nto run a single case.",
            "items": {
              "$ref": "#/$defs/TestCase"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "script_id"
        ],
        "type": "object"
      },
      "name": "extensions_scripts_test"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Change a script's name, source, test cases, enabled flag or targets",
      "inputSchema": {
        "$defs": {
          "ScriptId": {
            "format": "uuid",
