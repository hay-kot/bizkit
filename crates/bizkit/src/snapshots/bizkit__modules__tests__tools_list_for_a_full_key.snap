      "inputSchema": {
        "$defs": {
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Which entities to list.",
        "properties": {
          "kind": {
            "description": "The target kind, as `hooks[].target.id` spells it, such as `forms.form`.",
            "type": "string"
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project."
          }
