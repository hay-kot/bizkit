---
source: crates/bizkit/src/modules.rs
expression: tools
---
{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Make a dashboard: a name and saved insights in order",
      "inputSchema": {
        "$defs": {
          "InsightId": {
            "format": "uuid",
            "type": "string"
          },
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "A new dashboard.",
        "properties": {
          "insight_ids": {
            "description": "Insights of the project, in order; at most 20.",
            "items": {
              "$ref": "#/$defs/InsightId"
            },
            "type": "array"
          },
          "name": {
            "description": "The display name.",
            "type": "string"
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project."
          }
        },
        "required": [
          "project_id",
          "name"
        ],
        "type": "object"
      },
      "name": "analytics_dashboards_create"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false
      },
      "description": "Delete a dashboard; its insights stay",
      "inputSchema": {
        "$defs": {
          "DashboardId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "A dashboard of a workspace.",
        "properties": {
          "dashboard_id": {
            "$ref": "#/$defs/DashboardId",
            "description": "The dashboard."
          }
        },
        "required": [
          "dashboard_id"
        ],
        "type": "object"
      },
      "name": "analytics_dashboards_delete"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "Show a dashboard and its insights in order",
      "inputSchema": {
        "$defs": {
          "DashboardId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "A dashboard of a workspace.",
        "properties": {
