            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Changes to a funnel. Absent fields stay as they are.",
        "properties": {
          "funnel_id": {
            "$ref": "#/$defs/FunnelId",
            "description": "The funnel."
          },
          "name": {
            "description": "The display name.",
            "type": [
