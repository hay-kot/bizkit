        "properties": {
          "expires_in_days": {
            "description": "Days until the key expires; never when absent.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "description": "A label.",
            "type": "string"
          },
          "scopes": {
            "description": "Scopes such as `projects:read`. You can only grant scopes you hold.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "name",
          "scopes"
        ],
        "type": "object"
