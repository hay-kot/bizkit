    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "List a script's runs, newest first",
      "inputSchema": {
        "$defs": {
          "ScriptId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Which runs to list.",
        "properties": {
          "limit": {
            "description": "How many, 1-100. Default 50.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "script_id": {
            "$ref": "#/$defs/ScriptId",
            "description": "The script."
          }
        },
        "required": [
          "script_id"
        ],
        "type": "object"
      },
      "name": "extensions_runs_list"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Attach a script to a hook point in a project",
      "inputSchema": {
        "$defs": {
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          },
          "TestCase": {
            "additionalProperties": false,
            "description": "A saved input to run a script on, and what it must return.",
            "properties": {
              "expect": {
                "type": [
                  "object",
                  "array",
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "input": {
                "type": [
                  "object",
                  "array",
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "name": {
                "description": "A name, unique in the script.",
                "type": "string"
              }
            },
            "required": [
              "name",
              "input"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "A new script.",
        "properties": {
          "enabled": {
            "description": "Whether it runs. Default true.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "hook": {
            "description": "The hook point ID, such as `forms.pre_validate`. Fixed after create.",
            "type": "string"
          },
          "name": {
            "description": "The display name.",
            "type": "string"
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project it belongs to."
          },
          "source": {
            "description": "An ES module whose default export runs, at most 64 KiB.",
            "type": "string"
          },
          "target_ids": {
            "description": "The entities of the point's target kind it runs for, such as form\nIDs, at most 100. Empty or absent: every entity of the kind.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "tests": {
            "description": "Saved test cases, at most 20. Default one case on the point's\nsample input.",
            "items": {
              "$ref": "#/$defs/TestCase"
            },
            "type": [
              "array",
              "null"
            ]
          }
        },
        "required": [
          "project_id",
          "hook",
          "name",
          "source"
        ],
        "type": "object"
      },
      "name": "extensions_scripts_create"
    },
    {
      "annotations": {
