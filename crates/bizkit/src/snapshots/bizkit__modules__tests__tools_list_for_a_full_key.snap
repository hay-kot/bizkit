        "additionalProperties": false,
        "description": "Changes to a script. Absent fields stay as they are.",
        "properties": {
          "enabled": {
            "description": "Whether it runs.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "name": {
            "description": "The display name.",
            "type": [
              "string",
              "null"
            ]
          },
          "script_id": {
            "$ref": "#/$defs/ScriptId",
            "description": "The script."
          },
          "source": {
            "description": "The ES module source, at most 64 KiB.",
            "type": [
              "string",
              "null"
            ]
          },
          "target_ids": {
            "description": "Replaces the target set, at most 100. Empty: every entity of the\npoint's kind.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "tests": {
            "description": "Replaces the saved test cases, at most 20.",
            "items": {
              "$ref": "#/$defs/TestCase"
            },
            "type": [
              "array",
