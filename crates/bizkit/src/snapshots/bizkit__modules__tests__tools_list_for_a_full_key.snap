    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Create a form in a project",
      "inputSchema": {
        "$defs": {
          "BotCheck": {
            "description": "How a form tells people from bots.",
            "enum": [
              "honeypot",
              "challenge"
            ],
            "type": "string"
          },
          "FieldDef": {
            "additionalProperties": false,
            "description": "A field a form accepts.",
            "properties": {
              "kind": {
                "$ref": "#/$defs/FieldKind",
                "description": "How values are checked."
              },
              "label": {
                "description": "A label for the UI and mail; the name when absent.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "max_length": {
                "description": "The longest value, 1-10000 characters. Default 10000.",
                "format": "int32",
                "minimum": 0,
                "type": [
                  "integer",
                  "null"
                ]
              },
              "multiple": {
                "description": "A `choice` field may take several values.",
                "type": "boolean"
              },
              "name": {
                "description": "The input's `name`: 1-64 of `a-z`, `A-Z`, `0-9`, `_` and `-`, not\nstarting with `_`, unique in the form.",
                "type": "string"
              },
              "options": {
                "description": "The allowed values of a `choice` field, 1-50 of them.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "required": {
                "description": "At least one non-blank value is needed.",
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "kind"
            ],
            "type": "object"
          },
          "FieldKind": {
            "description": "What a field holds, which decides how it is checked.",
            "enum": [
              "text",
              "email",
              "url",
              "number",
              "choice"
            ],
            "type": "string"
          },
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "A new form.",
        "properties": {
          "bot_check": {
            "oneOf": [
              {
                "$ref": "#/$defs/BotCheck",
                "description": "The bot check. Default `honeypot`."
              },
              {
                "type": "null"
              }
            ]
          },
          "fields": {
            "description": "The accepted fields. Default none, which keeps every field.",
            "items": {
              "$ref": "#/$defs/FieldDef"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "min_fill_ms": {
            "description": "With `challenge`: the least ms between loading the challenge and submitting, 0-600000. Default 2000.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "description": "The display name.",
            "type": "string"
          },
          "notify_emails": {
            "description": "Who gets mail for each new submission, at most 10.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project it belongs to."
          },
          "redirect_url": {
            "description": "Where browsers go after a plain form post, http or https.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "project_id",
          "name"
        ],
        "type": "object"
      },
      "name": "forms_create"
    },
