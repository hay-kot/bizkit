    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Run an insight query: events by total, users, share of active users or per-user count, or people by trait, with filters and an optional breakdown",
      "inputSchema": {
        "$defs": {
          "BreakdownBy": {
            "additionalProperties": false,
            "description": "Split the result by one property or trait.",
            "properties": {
              "key": {
                "description": "The property or trait name.",
                "type": "string"
              },
              "source": {
                "$ref": "#/$defs/BreakdownSource",
                "description": "Where the value comes from."
              }
            },
            "required": [
              "source",
              "key"
            ],
            "type": "object"
          },
          "BreakdownSource": {
            "description": "Where a breakdown value comes from.",
            "enum": [
              "property",
              "trait"
            ],
            "type": "string"
          },
          "Day": {
            "format": "date",
            "type": "string"
          },
          "FilterOp": {
            "description": "A filter's comparison.",
            "enum": [
              "is",
              "is_not",
              "gt",
              "lt",
              "is_set"
            ],
            "type": "string"
          },
          "FilterValue": {
            "description": "A filter value: text, a number or a boolean.",
            "oneOf": [
              {
                "description": "A boolean.",
                "type": "boolean"
              },
              {
                "description": "A number.",
                "format": "double",
                "type": "number"
              },
              {
                "description": "Text. Text that reads as a number also compares as one.",
                "type": "string"
              }
            ]
          },
          "InsightFilter": {
            "additionalProperties": false,
            "description": "One condition on an event property, or on a trait for the people kind.",
            "properties": {
              "key": {
                "description": "The property or trait name.",
                "type": "string"
              },
              "op": {
                "$ref": "#/$defs/FilterOp",
                "description": "The comparison."
              },
              "value": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/FilterValue",
                    "description": "The value: text for `is` and `is_not`, a number for `gt` and `lt`,\nnone for `is_set`."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "key",
              "op"
            ],
            "type": "object"
          },
          "InsightKind": {
            "description": "What an insight counts.",
            "enum": [
              "events",
              "people"
            ],
            "type": "string"
          },
          "InsightQuery": {
            "additionalProperties": false,
            "description": "A typed analytics question. Events insights read raw events, so they\nreach back only as far as raw retention (90 days by default); keep\nlifetime counts in traits and ask the people kind.",
            "properties": {
              "breakdown": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/BreakdownBy",
                    "description": "Split by one property or trait: the top 10 values, then the rest.\nNot with `per_user`; people break down by trait only."
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "event": {
                "description": "The event name (`pageview` included). Required for events; absent\nfor people.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "filters": {
                "description": "All must match: event properties for events, traits for people.\nAt most 10.",
                "items": {
                  "$ref": "#/$defs/InsightFilter"
                },
                "type": "array"
              },
              "kind": {
                "$ref": "#/$defs/InsightKind",
                "description": "Events or people."
              },
              "measure": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/Measure",
                    "description": "How events count; default `total`. Absent for people, which count\npeople."
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "Measure": {
            "description": "How an events insight counts.",
            "enum": [
              "total",
              "users",
              "share",
              "per_user"
            ],
            "type": "string"
          },
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "An insight query to run over a range.",
        "properties": {
          "from": {
            "$ref": "#/$defs/Day",
            "description": "The first day, UTC. People insights ignore the range."
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project."
          },
          "query": {
            "$ref": "#/$defs/InsightQuery",
            "description": "What to count."
          },
          "to": {
            "$ref": "#/$defs/Day",
            "description": "The last day, UTC, inclusive. At most 400 days after `from`."
          }
        },
        "required": [
          "project_id",
          "from",
          "to",
          "query"
        ],
        "type": "object"
      },
      "name": "analytics_insights_query"
    },
