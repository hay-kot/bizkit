---
source: crates/bizkit/src/modules.rs
expression: tools
---
{
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Add a goal: a page or event that counts as a conversion",
      "inputSchema": {
        "$defs": {
          "GoalKind": {
            "description": "What a goal matches.",
            "enum": [
              "page",
              "event"
            ],
            "type": "string"
          },
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "A new goal.",
        "properties": {
          "kind": {
            "$ref": "#/$defs/GoalKind",
            "description": "What it matches."
          },
          "match": {
            "description": "A page path starting with `/`, or an event name.",
            "type": "string"
          },
          "name": {
            "description": "The display name.",
            "type": "string"
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project."
          }
        },
        "required": [
          "project_id",
          "name",
          "kind",
          "match"
        ],
        "type": "object"
      },
      "name": "analytics_goals_create"
    },
    {
      "annotations": {
        "destructiveHint": true,
        "readOnlyHint": false
      },
      "description": "Delete an analytics goal",
      "inputSchema": {
        "$defs": {
          "GoalId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "A goal of a workspace.",
        "properties": {
          "goal_id": {
            "$ref": "#/$defs/GoalId",
            "description": "The goal."
          }
        },
        "required": [
          "goal_id"
        ],
        "type": "object"
      },
      "name": "analytics_goals_delete"
    },
    {
