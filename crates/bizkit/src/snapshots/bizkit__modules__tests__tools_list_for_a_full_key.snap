    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Change a project's analytics settings",
      "inputSchema": {
        "$defs": {
          "IdentityMode": {
            "description": "What the snippet may store in a visitor's browser.",
            "enum": [
              "cookieless",
              "after_identify",
              "always"
            ],
            "type": "string"
          },
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Changes to a site. Absent fields stay as they are.",
        "properties": {
          "hostnames": {
            "description": "Hostnames the snippet may send from, exact or `*.example.com`; empty\nallows any host.",
            "items": {
              "type": "string"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "identity_mode": {
            "oneOf": [
              {
                "$ref": "#/$defs/IdentityMode",
                "description": "What the snippet may store in a visitor's browser."
              },
              {
                "type": "null"
              }
            ]
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project."
          }
        },
        "required": [
          "project_id"
        ],
        "type": "object"
      },
      "name": "analytics_site_update"
    },
    {
      "annotations": {
