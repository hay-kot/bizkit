          }
        },
        "additionalProperties": false,
        "description": "A project's insights or dashboards.",
        "properties": {
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project."
          }
        },
        "required": [
          "project_id"
        ],
        "type": "object"
      },
      "name": "analytics_dashboards_list"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Rename a dashboard or set its insights: the whole list, in order",
      "inputSchema": {
        "$defs": {
          "DashboardId": {
            "format": "uuid",
            "type": "string"
          },
          "InsightId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Changes to a dashboard. Absent fields stay as they are.",
        "properties": {
          "dashboard_id": {
            "$ref": "#/$defs/DashboardId",
            "description": "The dashboard."
          },
          "insight_ids": {
            "description": "The whole new list of insights, in order; at most 20. Add, remove\nand reorder by sending the list.",
            "items": {
              "$ref": "#/$defs/InsightId"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "name": {
            "description": "The display name.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "dashboard_id"
        ],
        "type": "object"
      },
      "name": "analytics_dashboards_update"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Record product events from your server",
      "inputSchema": {
        "$defs": {
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          },
          "ServerEvent": {
            "additionalProperties": false,
            "description": "One event from a server.",
            "properties": {
              "anon_id": {
                "description": "The anonymous ID the snippet stored, to link browser events.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "description": "A custom event name (1-64 letters, digits, or `_ . : -`),\n`pageview`, or `$identify` to record traits and link `anon_id` to\n`user_id`.",
                "type": "string"
              },
              "props": {
                "description": "Event properties: at most 20, with string (256 characters), number\nor boolean values.",
                "type": [
                  "object",
                  "null"
                ]
              },
              "traits": {
                "description": "User traits, for `$identify` only. Same limits as `props`.",
                "type": [
                  "object",
                  "null"
                ]
              },
              "url": {
                "description": "The page the event relates to; its path and UTM tags are kept.",
                "type": [
                  "string",
                  "null"
                ]
              },
              "user_id": {
                "description": "Your ID for the user. Needed for `$identify`; one of `user_id` and\n`anon_id` is needed for every event.",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "Events to record.",
        "properties": {
          "events": {
            "description": "1 to 100 events. They take the time they arrive.",
            "items": {
              "$ref": "#/$defs/ServerEvent"
            },
            "type": "array"
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project whose site gets the events."
          }
        },
        "required": [
          "project_id",
          "events"
        ],
        "type": "object"
      },
      "name": "analytics_events_ingest"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "Count product events over time, filtered by name and properties",
      "inputSchema": {
        "$defs": {
          "Day": {
            "format": "date",
            "type": "string"
          },
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Event counts over a range.",
        "properties": {
          "from": {
            "$ref": "#/$defs/Day",
            "description": "The first day, UTC."
          },
          "name": {
            "description": "Only this event name (`pageview` included); default every custom event.",
            "type": [
              "string",
              "null"
            ]
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project."
          },
          "props": {
            "description": "Property filters, `key=value`; all must match.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "to": {
            "$ref": "#/$defs/Day",
            "description": "The last day, UTC, inclusive."
          }
        },
        "required": [
          "project_id",
          "from",
          "to"
        ],
        "type": "object"
      },
      "name": "analytics_events_query"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": true
      },
      "description": "List recent analytics events, newest first",
      "inputSchema": {
        "$defs": {
          "Day": {
            "format": "date",
            "type": "string"
          },
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "A page of recent events.",
        "properties": {
          "before": {
            "description": "Events older than this one, from `next_before`.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "from": {
            "$ref": "#/$defs/Day",
            "description": "The first day, UTC."
          },
          "limit": {
            "description": "At most this many, 1-200. Default 50.",
            "format": "int32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "name": {
            "description": "Only this event name; default every event, pageviews included.",
            "type": [
              "string",
              "null"
            ]
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project."
          },
          "props": {
            "description": "Property filters, `key=value`; all must match.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "to": {
            "$ref": "#/$defs/Day",
            "description": "The last day, UTC, inclusive."
          }
        },
        "required": [
          "project_id",
          "from",
          "to"
        ],
        "type": "object"
      },
      "name": "analytics_events_recent"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "readOnlyHint": false
      },
      "description": "Save a funnel: 2 to 8 page or event steps",
      "inputSchema": {
        "$defs": {
          "GoalKind": {
            "description": "What a goal matches.",
            "enum": [
              "page",
              "event"
            ],
            "type": "string"
          },
          "ProjectId": {
            "format": "uuid",
            "type": "string"
          },
          "Step": {
            "additionalProperties": false,
            "description": "One funnel step.",
            "properties": {
              "kind": {
                "$ref": "#/$defs/GoalKind",
                "description": "A pageview or a custom event."
              },
              "match": {
                "description": "A page path (exact, or a prefix ending in `*`) or an event name.",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "match"
            ],
            "type": "object"
          }
        },
        "additionalProperties": false,
        "description": "A new funnel.",
        "properties": {
          "name": {
            "description": "The display name.",
            "type": "string"
          },
          "project_id": {
            "$ref": "#/$defs/ProjectId",
            "description": "The project."
          },
          "steps": {
            "description": "2 to 8 steps, in order.",
            "items": {
              "$ref": "#/$defs/Step"
            },
            "type": "array"
          },
          "window_days": {
            "description": "Days after the first step in which the rest must happen, 1-90.\nDefault 7.",
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "required": [
          "project_id",
          "name",
          "steps"
        ],
        "type": "object"
      },
      "name": "analytics_funnels_create"
    },
    {
      "annotations": {
        "destructiveHint": true,
